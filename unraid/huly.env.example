# ===== Stack identity =====
DOCKER_NAME=huly
HULY_VERSION=s0.7.426
DESKTOP_CHANNEL=0.7.426
# HULY_PULSE_VERSION=

# ===== Networking =====
# Public hostname served through the Cloudflare tunnel (no protocol, no trailing slash)
HOST_ADDRESS=huly.example.com
SECURE=true
# No host ports are published. The tunnel container reaches nginx by name.
CF_TUNNEL_TOKEN=CHANGE_ME

# ===== Branding and locale =====
TITLE=Platform
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

# ===== Secrets (openssl rand -hex 32) =====
SECRET=CHANGE_ME_HEX64

# ===== CockroachDB (password must match in CR_DB_URL) =====
CR_DATABASE=defaultdb
CR_USERNAME=selfhost
CR_USER_PASSWORD=CHANGE_ME_HEX64
CR_DB_URL=postgres://selfhost:CHANGE_ME_HEX64@cockroach:26257/defaultdb

# ===== Redpanda =====
REDPANDA_ADMIN_USER=superadmin
REDPANDA_ADMIN_PWD=CHANGE_ME_HEX64

# ===== Storage: dedicated Unraid share =====
VOLUME_ELASTIC_PATH=/mnt/cache/huly/elastic
VOLUME_FILES_PATH=/mnt/cache/huly/files
VOLUME_CR_DATA_PATH=/mnt/cache/huly/cockroach/data
VOLUME_CR_CERTS_PATH=/mnt/cache/huly/cockroach/certs
VOLUME_REDPANDA_PATH=/mnt/cache/huly/redpanda

# ===== Mail (SMTP) =====
MAIL_SOURCE=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ===== Web push (npx web-push generate-vapid-keys) =====
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ===== LiveKit / Love =====
# Internal URL used by the love service (stays inside the Docker network)
LIVEKIT_HOST=http://livekit:7880
# Public wss URL given to browsers; Cloudflare tunnel route -> http://livekit:7880
LIVEKIT_WS=wss://livekit.example.com
LIVEKIT_API_KEY=CHANGE_ME_KEY
LIVEKIT_API_SECRET=CHANGE_ME_HEX64

# ===== playit.gg tunnel for LiveKit media =====
# Order of operations:
#  1. Create a Docker agent in the playit dashboard and paste its secret below.
#  2. Start only the agent:  docker compose --env-file huly.env -f huly.yaml up -d playit
#  3. In the dashboard create one UDP tunnel and one TCP tunnel to the agent.
#     Note the public port playit assigns to each.
#  4. Put those public ports below. LiveKit listens on the SAME numbers inside
#     its container, because it advertises its local port to clients.
#  5. Set each tunnel's local/origin address to 172.30.0.10:<that same port>.
#  6. Set LIVEKIT_NODE_IP to the tunnel's public IP (dig +short <tunnel hostname>).
#  7. Start the rest of the stack.
PLAYIT_SECRET_KEY=CHANGE_ME
# Official agent image name/tag is unverified; check the playit dashboard wizard.
PLAYIT_IMAGE=ghcr.io/playit-cloud/playit-agent:latest
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
LIVEKIT_NODE_IP=0.0.0.0

# DISABLE_SIGNUP=true
