# ===== Stack identity =====
DOCKER_NAME=huly
HULY_VERSION=s0.7.426
DESKTOP_CHANNEL=0.7.426
# HULY_PULSE_VERSION=

# ===== Networking =====
HOST_ADDRESS=huly.example.com
SECURE=true
HTTP_BIND=0.0.0.0
HTTP_PORT=8087
CF_TUNNEL_TOKEN=CHANGE_ME

# ===== Branding and locale =====
TITLE=Platform
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

# ===== Secrets (openssl rand -hex 32) =====
SECRET=CHANGE_ME_HEX64

# ===== CockroachDB (password must match in CR_DB_URL) =====
CR_DATABASE=defaultdb
CR_USERNAME=selfhost
CR_USER_PASSWORD=CHANGE_ME_HEX64
CR_DB_URL=postgres://selfhost:CHANGE_ME_HEX64@cockroach:26257/defaultdb

# ===== Redpanda =====
REDPANDA_ADMIN_USER=superadmin
REDPANDA_ADMIN_PWD=CHANGE_ME_HEX64

# ===== Storage: dedicated Unraid share =====
VOLUME_ELASTIC_PATH=/mnt/cache/huly/elastic
VOLUME_FILES_PATH=/mnt/cache/huly/files
VOLUME_CR_DATA_PATH=/mnt/cache/huly/cockroach/data
VOLUME_CR_CERTS_PATH=/mnt/cache/huly/cockroach/certs
VOLUME_REDPANDA_PATH=/mnt/cache/huly/redpanda

# ===== Mail (SMTP) =====
MAIL_SOURCE=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ===== Web push (npx web-push generate-vapid-keys) =====
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ===== LiveKit / Love =====
# Public wss URL served through the Cloudflare tunnel -> http://livekit:7880
LIVEKIT_HOST=wss://livekit.example.com
LIVEKIT_API_KEY=CHANGE_ME_KEY
LIVEKIT_API_SECRET=CHANGE_ME_HEX64
# Public IP of the playit.gg tunnel (media address advertised to clients)
LIVEKIT_NODE_IP=CHANGE_ME_PLAYIT_IP

# DISABLE_SIGNUP=true
