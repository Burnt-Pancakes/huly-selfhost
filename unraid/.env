# =====================================================================
#  HULY ON UNRAID  -  .env
#  Read this file top to bottom. It is the only file you need to edit.
#  Every line marked  <== EDIT  must be changed before the first start.
#  Lines starting with # are comments. Do not put spaces around the = sign.
# =====================================================================
#
#  QUICK START
#   1. Put this file and docker-compose.yml together in /mnt/cache/huly
#      (Compose automatically reads a file named .env in the same folder).
#   2. Fill in the Cloudflare, mail and LiveKit values below.
#   3. Generate the secrets. Fastest way: run this block once in the Unraid
#      terminal (it overwrites the CHANGE_ME secret lines in this file):
#
#        cd /mnt/cache/huly
#        CRPW=$(openssl rand -hex 32)
#        sed -i \
#          -e "s|^SECRET=.*|SECRET=$(openssl rand -hex 32)|" \
#          -e "s|^CR_USER_PASSWORD=.*|CR_USER_PASSWORD=$CRPW|" \
#          -e "s|^CR_DB_URL=.*|CR_DB_URL=postgres://selfhost:$CRPW@cockroach:26257/defaultdb|" \
#          -e "s|^REDPANDA_ADMIN_PWD=.*|REDPANDA_ADMIN_PWD=$(openssl rand -hex 32)|" \
#          -e "s|^LIVEKIT_API_KEY=.*|LIVEKIT_API_KEY=API$(openssl rand -hex 8)|" \
#          -e "s|^LIVEKIT_API_SECRET=.*|LIVEKIT_API_SECRET=$(openssl rand -hex 32)|" .env
#
#      (If you prefer, generate each value yourself with: openssl rand -hex 32)
#   4. Check for mistakes:   docker compose config
#   5. Follow the playit.gg steps near the bottom, then:   docker compose up -d
#
#  NEVER commit a filled-in copy of this file to GitHub.
# =====================================================================


# ---------------------------------------------------------------------
#  1. STACK IDENTITY
# ---------------------------------------------------------------------
# DOCKER_NAME   Name of the Compose project; prefixes container and network names
#               (networks become <DOCKER_NAME>_net and <DOCKER_NAME>_egress).
#               Leave as is unless you run two stacks on one server.
DOCKER_NAME=huly

# HULY_VERSION  Release tag of the Huly container images (platformcollective/*).
#               Before changing it, read MIGRATION.md in the repo root and back up.
HULY_VERSION=s0.7.426

# DESKTOP_CHANNEL  Update channel announced to the desktop app. Use the same number
#               as HULY_VERSION without the leading letter (s0.7.426 -> 0.7.426).
DESKTOP_CHANNEL=0.7.426

# HULY_PULSE_VERSION  Optional. Image tag for the hulypulse service. Leave commented
#               out to follow HULY_VERSION.
# HULY_PULSE_VERSION=


# ---------------------------------------------------------------------
#  2. NETWORKING  (Cloudflare Tunnel)
# ---------------------------------------------------------------------
# HOST_ADDRESS  The public hostname people type in the browser. No https://,
#               no trailing slash.  Example: huly.example.com            <== EDIT
HOST_ADDRESS=huly.example.com

# SECURE        true = the site is served over HTTPS/WSS (always true with
#               Cloudflare Tunnel). Leave empty only for plain-HTTP testing.
SECURE=true

# CF_TUNNEL_TOKEN  Token of your Cloudflare Tunnel. Cloudflare dashboard ->
#               Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker; copy the
#               long string after "--token".                              <== EDIT
#               In the tunnel's Public Hostnames add two routes:
#                 huly.example.com    ->  http://nginx:80
#                 livekit.example.com ->  http://livekit:7880
#               No ports are published on your server; nothing is reachable on the LAN.
CF_TUNNEL_TOKEN=CHANGE_ME


# ---------------------------------------------------------------------
#  3. BRANDING AND LOCALE  (optional)
# ---------------------------------------------------------------------
# TITLE             Name shown in the browser tab and app.
TITLE=Platform
# DEFAULT_LANGUAGE  Default interface language code (en, de, fr, ...).
DEFAULT_LANGUAGE=en
# LAST_NAME_FIRST   true = show names as "Last First".
LAST_NAME_FIRST=true


# ---------------------------------------------------------------------
#  4. SECRETS  (generate, do not invent)
# ---------------------------------------------------------------------
# SECRET  Shared secret the Huly services use to trust each other and sign tokens.
#         Use 64 random hex characters:  openssl rand -hex 32              <== EDIT
#         Changing it later logs everyone out.
SECRET=CHANGE_ME_HEX64


# ---------------------------------------------------------------------
#  5. DATABASE (CockroachDB)
# ---------------------------------------------------------------------
# CR_DATABASE       Database name. Leave as is.
CR_DATABASE=defaultdb
# CR_USERNAME       Database user. Leave as is (it must also match CR_DB_URL below).
CR_USERNAME=selfhost
# CR_USER_PASSWORD  Database password:  openssl rand -hex 32                <== EDIT
CR_USER_PASSWORD=CHANGE_ME_HEX64
# CR_DB_URL         Connection string used by every service. The password in it
#                   MUST be the same as CR_USER_PASSWORD above.            <== EDIT
#                   Format: postgres://selfhost:<CR_USER_PASSWORD>@cockroach:26257/defaultdb
CR_DB_URL=postgres://selfhost:CHANGE_ME_HEX64@cockroach:26257/defaultdb


# ---------------------------------------------------------------------
#  6. MESSAGE QUEUE (Redpanda)
# ---------------------------------------------------------------------
# REDPANDA_ADMIN_USER  Admin user name for Redpanda. Leave as is.
REDPANDA_ADMIN_USER=superadmin
# REDPANDA_ADMIN_PWD   Admin password:  openssl rand -hex 32                <== EDIT
REDPANDA_ADMIN_PWD=CHANGE_ME_HEX64


# ---------------------------------------------------------------------
#  7. STORAGE PATHS  (your Unraid share)
# ---------------------------------------------------------------------
# Create the folders first, then give each to the UID its container runs as:
#   mkdir -p /mnt/cache/huly/{elastic,files,redpanda,cockroach/data,cockroach/certs}
#   chown -R 1000:1000 /mnt/cache/huly/{elastic,files,cockroach}
#   chown -R 101:101   /mnt/cache/huly/redpanda
# (rootless Docker/Podman: add your subuid offset. If a container logs
#  "permission denied", fix the owner of that folder.)
# Use /mnt/cache/... (or a cache-only share). Databases are slow on /mnt/user.
# VOLUME_ELASTIC_PATH     Search index.
VOLUME_ELASTIC_PATH=/mnt/cache/huly/elastic
# VOLUME_FILES_PATH       Uploaded files (the object store, service name: minio).
VOLUME_FILES_PATH=/mnt/cache/huly/files
# VOLUME_CR_DATA_PATH     Database files.
VOLUME_CR_DATA_PATH=/mnt/cache/huly/cockroach/data
# VOLUME_CR_CERTS_PATH    Database certificates folder.
VOLUME_CR_CERTS_PATH=/mnt/cache/huly/cockroach/certs
# VOLUME_REDPANDA_PATH    Message queue data.
VOLUME_REDPANDA_PATH=/mnt/cache/huly/redpanda


# ---------------------------------------------------------------------
#  8. MAIL (SMTP)  - sign-up confirmations and notification emails
# ---------------------------------------------------------------------
# MAIL_SOURCE    The "From" address.                                        <== EDIT
MAIL_SOURCE=noreply@example.com
# SMTP_HOST      Your mail server, e.g. smtp.example.com. Leave empty to skip mail;
#                then the mail service may restart repeatedly - remove it from
#                docker-compose.yml (and MAIL_URL from account and transactor).
SMTP_HOST=
# SMTP_PORT      587 is the usual secure port.
SMTP_PORT=587
# SMTP_USERNAME / SMTP_PASSWORD  Login for the mail server (an app password is best).
SMTP_USERNAME=
SMTP_PASSWORD=


# ---------------------------------------------------------------------
#  9. WEB PUSH NOTIFICATIONS
# ---------------------------------------------------------------------
# A VAPID key pair lets the server push notifications to browsers. Generate it once
# on the Unraid terminal and copy the two lines it prints:
#   docker run --rm node:20-alpine npx -y web-push generate-vapid-keys
# PUSH_PUBLIC_KEY   The "Public Key" it prints.                            <== EDIT
PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY  The "Private Key" it prints. Keep it secret.            <== EDIT
PUSH_PRIVATE_KEY=


# ---------------------------------------------------------------------
#  10. CALLS: LIVEKIT AND LOVE
# ---------------------------------------------------------------------
# LIVEKIT_HOST        Internal address the "love" service uses to reach LiveKit.
#                     Leave as is.
LIVEKIT_HOST=http://livekit:7880
# LIVEKIT_WS          Public address browsers use. It is the Cloudflare Tunnel
#                     route to http://livekit:7880, with wss:// in front.     <== EDIT
LIVEKIT_WS=wss://livekit.example.com
# LIVEKIT_PROJECT     A label for your LiveKit project. The love service refuses to
#                     start without it. Any short text works; leave as is.
LIVEKIT_PROJECT=huly
# LIVEKIT_API_KEY     A name for the key, not a password. Any letters/numbers work;
#                     use the prefix API plus random hex so it is always text:
#                       echo "API$(openssl rand -hex 8)"                     <== EDIT
LIVEKIT_API_KEY=CHANGE_ME_KEY
# LIVEKIT_API_SECRET  The password for that key (keep it at least 32 characters):
#                       openssl rand -hex 32                                 <== EDIT
LIVEKIT_API_SECRET=CHANGE_ME_HEX64


# ---------------------------------------------------------------------
#  11. CALLS: playit.gg TUNNEL FOR AUDIO/VIDEO
# ---------------------------------------------------------------------
# Calls need UDP, which Cloudflare Tunnel cannot carry. playit.gg carries it.
#
# HOW THE PORTS WORK (read this first)
#  - LiveKit tells browsers which port it is listening on. It cannot advertise a
#    different public port. So the PUBLIC port playit gives you and the port
#    LiveKit LISTENS on inside the container must be the SAME NUMBER.
#  - In the playit dashboard, "Local Port" is that same number. It is NOT 7880.
#    (7880 is LiveKit's web/signalling port; Cloudflare Tunnel carries that.)
#  - Simplest setup: ONE playit tunnel of type "TCP & UDP". It has one public
#    port. Use that number for BOTH LIVEKIT_UDP_PORT and LIVEKIT_TCP_PORT.
#    TCP and UDP can share a number. If LiveKit reports a port bind error in
#    "docker compose logs livekit", use two separate tunnels with two numbers.
#
# STEPS (the tunnel comes first because LiveKit has to use playit's port):
#   1. playit.gg dashboard -> create a Docker agent; copy its secret to
#      PLAYIT_SECRET_KEY below.
#   2. Start only the agent:   docker compose up -d playit
#   3. In the dashboard create one "TCP & UDP" tunnel on that agent. Note the
#      public port and the public IP address it shows.
#   4. Put the port number in LIVEKIT_UDP_PORT and LIVEKIT_TCP_PORT below.
#   5. In the tunnel's Origin Configuration set:
#        Local IP         livekit   (the Docker service name; no IP needed)
#        Local Port       the same number as the public port from step 3
#        Proxy Protocol   None
#      If the agent cannot resolve "livekit", see Troubleshooting in the README.
#   6. Put the tunnel's public IP in LIVEKIT_NODE_IP. Copy it from the dashboard.
#      If the dashboard only shows a hostname (like name.tun.ply.gg), look up its
#      IP with:   dig +short name.tun.ply.gg
#      (dig is a standard DNS lookup tool; it prints the IP behind a hostname.
#       If it is missing, install dnsutils/bind-utils, or use: nslookup name.tun.ply.gg)
#   7. Start everything:   docker compose up -d
# If the tunnel's IP ever changes, update LIVEKIT_NODE_IP and restart livekit.
# If you cannot choose matching ports, use LiveKit Cloud instead (see README).
#
# PLAYIT_SECRET_KEY   Secret of your playit Docker agent.                    <== EDIT
PLAYIT_SECRET_KEY=CHANGE_ME
# PLAYIT_IMAGE        Agent image. The name below is unverified; copy the image
#                     name from the playit Docker setup wizard if it differs.
PLAYIT_IMAGE=ghcr.io/playit-cloud/playit-agent:latest
# LIVEKIT_UDP_PORT    The tunnel's public port (step 3). Same number as Local Port.   <== EDIT
LIVEKIT_UDP_PORT=7882
# LIVEKIT_TCP_PORT    Same number again when you use one TCP & UDP tunnel.            <== EDIT
LIVEKIT_TCP_PORT=7882
# LIVEKIT_NODE_IP     Public IP address of the playit tunnel (step 6).                <== EDIT
LIVEKIT_NODE_IP=0.0.0.0


# ---------------------------------------------------------------------
#  12. OPTIONAL: DISABLE PUBLIC SIGN-UP
# ---------------------------------------------------------------------
# After you create your own account, stop strangers from registering: add the line
#   - DISABLE_SIGNUP=true
# under "environment:" of BOTH the account and front services in docker-compose.yml,
# then run   docker compose up -d
